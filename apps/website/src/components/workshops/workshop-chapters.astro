---
import {
	getWorkshopForSale,
	getTicketPurchase,
} from '../../coursebuilder/workshops';
import { getCourseBuilderUserForClerkUser } from '../../coursebuilder/users';
import { getLessonPreviewAccess } from '../../server/content-access';
import {
	chapterUnlockLabel,
	isChapterUnlocked,
	privateLessonHeaders,
} from '../../coursebuilder/workshop-lessons';
interface Props {
	slug: string;
}
const clerkUser = await Astro.locals.currentUser?.();
const viewer = await getCourseBuilderUserForClerkUser(clerkUser ?? null);
const workshop = await getWorkshopForSale(Astro.props.slug, new Date(), (id) =>
	getLessonPreviewAccess(viewer, id),
);
const hasTicket = Boolean(
	viewer &&
	workshop &&
	(await getTicketPurchase(viewer.id, workshop.accessProductIds)),
);
for (const [key, value] of Object.entries(privateLessonHeaders))
	Astro.response.headers.set(key, value);
const previews = new Set<string>();
if (workshop) {
	for (const chapter of workshop.chapters) {
		if (await getLessonPreviewAccess(viewer, chapter.id))
			previews.add(chapter.id);
	}
}
const now = new Date();
---

{
	workshop && (
		<ol>
			{workshop.chapters.map((chapter) => (
				<li>
					{previews.has(chapter.id) ||
					(hasTicket && isChapterUnlocked(chapter.startsAt, now)) ? (
						<a href={`/workshops/${workshop.slug}/${chapter.slug}`}>
							{chapter.title}
						</a>
					) : (
						<span>{chapter.title}</span>
					)}
					<p>
						{previews.has(chapter.id) &&
						!isChapterUnlocked(chapter.startsAt, now)
							? `Preview: ${chapterUnlockLabel(chapter.startsAt).replace('Unlocks', 'unlocks for buyers')}`
							: chapterUnlockLabel(chapter.startsAt)}
					</p>
				</li>
			))}
		</ol>
	)
}
