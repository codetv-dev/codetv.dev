---
import { getCourseBuilderUserForClerkUser } from '../../coursebuilder/users';
import { getTicketPurchase } from '../../coursebuilder/workshops';
import {
	isActiveSupporter,
	memberCheckoutPath,
} from '../../coursebuilder/supporter-coupons';

interface Props {
	productId: string;
}
const { productId } = Astro.props;
const clerkUser = await Astro.locals.currentUser?.();
const viewer = await getCourseBuilderUserForClerkUser(clerkUser ?? null);
const hasTicket = viewer
	? Boolean(await getTicketPurchase(viewer.id, [productId]))
	: false;
const memberUrl =
	!hasTicket && isActiveSupporter(clerkUser)
		? memberCheckoutPath(productId)
		: null;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'no-store');
---

{
	memberUrl && (
		<p data-member-offer>
			<a href={memberUrl} data-astro-reload>
				Use your member price: 50% off ($250)
			</a>
		</p>
	)
}

{
	hasTicket && (
		<div class="workshop-pricing" data-ticket-owned>
			<p class="status">You have a ticket for this cohort.</p>
		</div>
	)
}
