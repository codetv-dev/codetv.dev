---
import WorkshopTicket from '../../components/workshops/workshop-ticket.astro';
import Layout from '../../layouts/default.astro';
import Block from '../../components/design-system/block.astro';
import { WorkshopPricing } from '../../components/workshops/workshop-pricing';
import {
	getWorkshopSeo,
	renderWorkshopBody,
} from '../../coursebuilder/workshop-page';
import { getDefaultWorkshopOffer } from '../../coursebuilder/workshop-price';
import { workshopCacheControl } from '../../coursebuilder/workshop-cache';
import {
	getWorkshopForSale,
	resolveCouponCode,
} from '../../coursebuilder/workshops';
import { getTrustedCountry } from '../../coursebuilder/request-country';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const pageStartedAt = new Date();
const workshop = await getWorkshopForSale(slug, pageStartedAt);

if (!workshop) {
	return Astro.rewrite('/404');
}

const sections = renderWorkshopBody(workshop.body);
const hasBody = Boolean(workshop.body?.trim());
const seo = getWorkshopSeo(workshop);
const ticket = workshop.ticket;
const offer = ticket
	? await getDefaultWorkshopOffer(ticket.productId).catch((error) => {
			console.error('workshop.default-price.failed', {
				productId: ticket.productId,
				error,
			});
			return null;
		})
	: null;
const initialPrice = offer?.price ?? null;
// The shell contains only the default US offer, never viewer/code/PPP data.
// Do not cache a failed price lookup. Scheduled price/sales boundaries cap SWR.
Astro.response.headers.set('Cache-Control', 'no-cache');
Astro.response.headers.set(
	'Netlify-CDN-Cache-Control',
	ticket && !offer
		? 'no-store'
		: workshopCacheControl([
				offer?.expiresAt ?? null,
				...[ticket?.enrollment.opensAt, ticket?.enrollment.closesAt].filter(
					(date): date is Date => Boolean(date && date > pageStartedAt),
				),
			]),
);
Astro.response.headers.set('Netlify-Cache-Tag', `workshop:${workshop.id}`);
// Code offers remain request-scoped and uncached; preserve their checkout coupon.
const couponId = ticket
	? await resolveCouponCode(
			Astro.url.searchParams.get('code'),
			ticket.productId,
		)
	: null;

// Return here after sign-in or a cancelled checkout, keeping the coupon code.
const returnUrl = new URL(`/workshops/${workshop.slug}`, Astro.url);
const code = Astro.url.searchParams.get('code');
if (code) returnUrl.searchParams.set('code', code);
returnUrl.hash = 'ticket';

const dateFormat = new Intl.DateTimeFormat('en-US', {
	dateStyle: 'long',
	timeZone: 'America/Los_Angeles',
});
const cohort = ticket?.cohort;
const cohortDates =
	cohort?.startsAt && cohort?.endsAt
		? dateFormat.formatRange(cohort.startsAt, cohort.endsAt)
		: cohort?.startsAt
			? dateFormat.format(cohort.startsAt)
			: null;

// Placeholder copy until the CodeTV team writes the page. Matches the
// Workshop Ticket definition in CONTEXT.md.
const included = [
	'A seat in this live Cohort',
	'Lifetime access to the Workshop recordings and materials',
];
---

<Layout title={seo.title} description={seo.description}>
	<main class="workshop">
		<Block variant="two-column-asymmetrical" name="workshop-hero">
			<div class="heading">
				<p class="badge orange">Workshop</p>
			</div>
			<div class="copy-block">
				<h1>{workshop.title}</h1>
				{workshop.description && <p class="lede">{workshop.description}</p>}
				{
					cohortDates && (
						<p class="dates">
							<strong>Cohort:</strong> {cohortDates} (Pacific)
						</p>
					)
				}
				{
					ticket && (
						<a class="button workshop-hero-cta" href="#ticket">
							Get a ticket
						</a>
					)
				}
			</div>
		</Block>

		{
			sections.map((section) => (
				<Block variant="two-column-asymmetrical" name="workshop-body-section">
					<div class="heading workshop-section-heading">
						{section.headingHtml && <h2 set:html={section.headingHtml} />}
					</div>
					<div
						class:list={[
							'copy-block workshop-body',
							{
								'workshop-faq': /faq|frequently asked questions/i.test(
									section.headingHtml,
								),
							},
						]}
						set:html={section.bodyHtml}
					/>
				</Block>
			))
		}

		<Block variant="two-column-asymmetrical" emphasized name="ticket">
			<div class="heading"><h2 id="ticket">Get a ticket</h2></div>
			<div class="copy-block">
				{
					ticket ? (
						<>
							<WorkshopPricing
								client:load
								productId={ticket.productId}
								initialPrice={initialPrice}
								refineRegionalPrice={getTrustedCountry(Astro) !== 'US'}
								enrollment={{
									state: ticket.enrollment.state,
									opensAt: ticket.enrollment.opensAt?.toISOString() ?? null,
									closesAt: ticket.enrollment.closesAt?.toISOString() ?? null,
								}}
								couponId={couponId}
								canCheckout={true}
								hasTicket={false}
								checkoutNotice={Astro.url.searchParams.get('checkout')}
								returnUrl={returnUrl.toString()}
								devCountry={
									import.meta.env.DEV
										? Astro.url.searchParams.get('ppp_country')
										: null
								}
							/>
							<WorkshopTicket server:defer productId={ticket.productId} />
						</>
					) : (
						<p>Tickets aren’t on sale yet. Check back soon.</p>
					)
				}
			</div>
		</Block>

		{
			!hasBody && (
				<Block variant="two-column-asymmetrical">
					<div class="heading">
						<h2>What’s included</h2>
					</div>
					<div class="copy-block">
						<ul>
							{included.map((item) => (
								<li>{item}</li>
							))}
						</ul>
						{workshop.outline.length > 0 && (
							<>
								<h3>Workshop outline</h3>
								<ol>
									{workshop.outline.map((item) => (
										<li>{item.title}</li>
									))}
								</ol>
							</>
						)}
					</div>
				</Block>
			)
		}
	</main>
</Layout>

<style>
	/* The cached shell can sell to guests immediately. Only the private island
	   can hide buying controls for an owner. Checkout still enforces access. */
	.workshop
		:global(
			[data-name='ticket']:has([data-ticket-owned])
				.workshop-pricing
				:is(form, .ppp, .closes)
		) {
		display: none;
	}

	.workshop {
		h1 {
			font-size: clamp(2rem, 6cqi, 3.5rem);
			line-height: 1.05;
		}

		.lede {
			font-size: 1.25rem;
			margin-block-start: 16px;
		}

		.dates {
			margin-block-start: 16px;
		}

		:is(ul, ol) {
			margin-block-start: 16px;
		}

		li + li {
			margin-block-start: 8px;
		}

		h3 {
			margin-block-start: 32px;
		}

		.sign-in {
			margin-block-start: 16px;
		}
	}

	.workshop :global([data-name='ticket']) {
		align-content: start;
		row-gap: 1rem;
	}

	.workshop :global([data-name='workshop-hero']) {
		padding-block-end: 1.5rem;
	}

	@media (min-width: 1180px) {
		.workshop :global([data-name='workshop-hero']) {
			/* The desktop header is fixed rather than in normal flow. */
			padding-block-start: 5rem;
		}
	}

	.workshop :global([data-name='workshop-body-section']) {
		padding-block: 2rem;
	}

	.workshop
		:global([data-name='workshop-hero'] + [data-name='workshop-body-section']) {
		padding-block-start: 1.5rem;
	}

	#ticket {
		/* Clear the sticky/fixed header and leave room above the label. */
		scroll-margin-block-start: 5rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(html:has(.workshop)) {
			scroll-behavior: smooth;
		}
	}

	/* Keep the shared Block grid, with a smaller heading-to-copy gap on mobile. */
	.workshop :global([data-name='workshop-body-section']) {
		row-gap: 0.625rem;
	}

	/* Align all section labels, including the ticket/fallback labels. */
	.workshop :global(.block > .heading:has(> h2)) {
		justify-self: start;
	}

	.workshop-section-heading {
		&:empty {
			display: none;
		}

		h2 {
			font-family: var(--font-family-heading);
			font-size: clamp(1.375rem, 2.5cqi, 1.75rem);
			line-height: 1.2;
		}
	}

	.workshop-body {
		color: var(--text);
		font-family: var(--font-family);
		font-size: 1.0625rem;
		line-height: 1.6;
		max-inline-size: 68ch;
		min-inline-size: 0;
		overflow-wrap: anywhere;

		:global(> :first-child) {
			margin-block-start: 0;
		}

		:global(> * + *) {
			margin-block-start: 1.25rem;
		}

		:global(:is(h2, h3, h4)) {
			color: var(--text-emphasized);
			font-family: var(--font-family-heading);
			line-height: 1.2;
		}

		:global(:is(h2, h3, h4):not(:first-child)) {
			margin-block-start: 2.5rem;
		}

		:global(:is(h2, h3, h4) + *) {
			margin-block-start: 0.75rem;
		}

		:global(h3) {
			font-size: 1.25em;
		}

		:global(:is(ul, ol)) {
			padding-inline-start: 1.5em;
		}

		:global(li) {
			padding-inline-start: 0.25em;
		}

		:global(li + li) {
			margin-block-start: 0.5rem;
		}

		:global(li::marker) {
			color: var(--orange);
		}

		:global(li > :is(ul, ol, p) + *) {
			margin-block-start: 0.75rem;
		}

		:global(blockquote) {
			background: var(--bg);
			border-inline-start: 0.25rem solid var(--orange);
			color: var(--text-emphasized);
			font-style: italic;
			padding: 1rem 1.25rem;
		}

		:global(blockquote > * + *) {
			margin-block-start: 1rem;
		}

		:global(blockquote + p) {
			color: var(--text-muted);
			font-size: 1rem;
			margin-block-start: 0.5rem;
		}

		:global(blockquote + p + *) {
			margin-block-start: 1rem;
		}

		:global(a) {
			color: var(--text-link);
			text-decoration: underline;
			text-decoration-thickness: 0.08em;
			text-underline-offset: 0.15em;
		}

		:global(pre) {
			max-inline-size: 100%;
			overflow-x: auto;
		}
	}

	.workshop-faq {
		:global(p:has(> strong:first-child):not(:first-child)) {
			margin-block-start: 2rem;
		}

		:global(p > strong:first-child) {
			color: var(--text-emphasized);
			display: block;
			font-family: var(--font-family-heading);
			font-size: 1.1em;
			line-height: 1.35;
			margin-block-end: 0.5rem;
		}

		:global(p:has(> strong:first-child) + p:not(:has(> strong:first-child))) {
			margin-block-start: 0.5rem;
		}
	}

	.workshop-hero-cta {
		margin-block-start: 1rem;
		font-size: 1.125rem;
		line-height: 1.2;
		min-block-size: 44px;
		padding: 0.875rem 1.5rem;
		text-align: center;
	}

	.workshop-body :global(a:focus-visible),
	.workshop-hero-cta:focus-visible {
		outline: 3px solid var(--orange);
		outline-offset: 4px;
	}

	@media (min-width: 800px) {
		.workshop :global([data-name='workshop-body-section']) {
			row-gap: 2.5rem;
		}

		.workshop-body {
			font-size: 1.125rem;
			grid-column: 2;
		}
	}

	.workshop :global(.workshop-pricing) {
		.price {
			font-family: var(--font-family-heading);
			font-size: 2.5rem;
			font-weight: 900;
			line-height: 1;
		}

		.full {
			color: var(--text-muted);
			font-size: 1.25rem;
			font-weight: 400;
		}

		:is(.discount, .status, .closes, .notice, .ppp) {
			margin-block-start: 12px;
		}

		.notice {
			border-inline-start: 3px solid var(--orange);
			padding-inline-start: 12px;
		}

		.ppp {
			display: block;
			font-size: 0.875rem;
		}

		.closes {
			color: var(--text-muted);
			font-size: 0.875rem;
		}
	}
</style>
