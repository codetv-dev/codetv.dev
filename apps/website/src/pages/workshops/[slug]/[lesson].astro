---
import '../../../styles/workshop-body.css';
import { and, eq, isNull } from 'drizzle-orm';
import Layout from '../../../layouts/default.astro';
import Block from '../../../components/design-system/block.astro';
import MuxVideoPlayer from '../../../components/mux-video-player.astro';
import {
	getWorkshopForSale,
	getTicketPurchase,
} from '../../../coursebuilder/workshops';
import { getCourseBuilderUserForClerkUser } from '../../../coursebuilder/users';
import { getLessonPreviewAccess } from '../../../server/content-access';
import {
	chapterUnlockLabel,
	getLessonPlayback,
	isChapterUnlocked,
	privateLessonHeaders,
} from '../../../coursebuilder/workshop-lessons';
import { renderWorkshopBody } from '../../../coursebuilder/workshop-page';
import { db } from '../../../db';
import { contentResource } from '../../../db/schema';

export const prerender = false;
for (const [key, value] of Object.entries(privateLessonHeaders))
	Astro.response.headers.set(key, value);
const clerkUser = await Astro.locals.currentUser?.();
const viewer = await getCourseBuilderUserForClerkUser(clerkUser ?? null);
const workshop = await getWorkshopForSale(
	Astro.params.slug ?? '',
	new Date(),
	(id) => getLessonPreviewAccess(viewer, id),
);
const index =
	workshop?.chapters.findIndex(
		(chapter) =>
			chapter.slug === Astro.params.lesson ||
			chapter.id === Astro.params.lesson,
	) ?? -1;
if (!workshop || index < 0) return Astro.rewrite('/404');
const chapter = workshop.chapters[index];
const hasTicket = Boolean(
	viewer && (await getTicketPurchase(viewer.id, workshop.accessProductIds)),
);
const preview = await getLessonPreviewAccess(viewer, chapter.id);
const now = new Date();
const unlocked = isChapterUnlocked(chapter.startsAt, now);
let body: string | null = null;
const playback = await getLessonPlayback({
	hasTicket,
	previewAccess: preview,
	startsAt: chapter.startsAt,
	now,
	loadVideo: async () => {
		const lesson = await db.query.contentResource.findFirst({
			where: and(
				eq(contentResource.id, chapter.id),
				isNull(contentResource.deletedAt),
				eq(contentResource.type, 'lesson'),
			),
			with: { resources: { with: { resource: true } } },
		});
		const fields = (lesson?.fields ?? {}) as Record<string, unknown>;
		body = typeof fields.body === 'string' ? fields.body : null;
		if (typeof fields.videoResourceId !== 'string') {
			return (
				lesson?.resources.find(
					(link) =>
						link.resource?.type === 'videoResource' &&
						!link.deletedAt &&
						!link.resource.deletedAt,
				)?.resource?.fields ?? null
			);
		}
		const video = await db.query.contentResource.findFirst({
			where: and(
				eq(contentResource.id, fields.videoResourceId),
				isNull(contentResource.deletedAt),
				eq(contentResource.type, 'videoResource'),
			),
		});
		return video?.fields ?? null;
	},
});
const sections = renderWorkshopBody(body);
const previous = workshop.chapters[index - 1];
const next = workshop.chapters[index + 1];
const path = `/workshops/${workshop.slug}`;
---

<Layout title={`${chapter.title} | ${workshop.title}`}>
	<main class="workshop-lesson">
		<Block variant="two-column-asymmetrical" name="lesson-hero">
			<nav class="heading breadcrumb" aria-label="Breadcrumb">
				<a href={path}>{workshop.title}</a>
			</nav>
			<div class="copy-block">
				<h1>{chapter.title}</h1>
			</div>
		</Block>
		<Block variant="two-column-asymmetrical" name="lesson-content">
			{
				!hasTicket && !preview ? (
					<p class="copy-block lesson-notice">
						{chapterUnlockLabel(chapter.startsAt)}{' '}
						<a href={`${path}#ticket`}>Get a ticket</a> to watch this workshop.{' '}
						{!clerkUser && (
							<a
								href={`/dashboard/sign-in?redirect_url=${encodeURIComponent(Astro.url.pathname)}`}
							>
								Sign in
							</a>
						)}
					</p>
				) : !unlocked && !preview ? (
					<p class="copy-block lesson-notice">
						{chapterUnlockLabel(chapter.startsAt)}
					</p>
				) : (
					<>
						{preview && !unlocked && (
							<p class="copy-block lesson-notice">
								<small>
									Preview:{' '}
									{chapterUnlockLabel(chapter.startsAt).replace(
										'Unlocks',
										'unlocks for buyers',
									)}
								</small>
							</p>
						)}
						{playback ? (
							<div class="lesson-video">
								<MuxVideoPlayer
									playback_ids={[playback]}
									title={chapter.title}
									publish_date={chapter.startsAt}
									autoplay={false}
									workshopAccess={true}
								/>
							</div>
						) : (
							<p class="copy-block lesson-notice">
								The video is not available yet.
							</p>
						)}
						<article class="copy-block lesson-body">
							{sections.map((section) => (
								<section class="workshop-body">
									{section.headingHtml && <h2 set:html={section.headingHtml} />}
									<div class="workshop-body" set:html={section.bodyHtml} />
								</section>
							))}
						</article>
					</>
				)
			}
		</Block>
		<Block variant="two-column-asymmetrical" name="lesson-navigation">
			<nav class="copy-block lesson-navigation" aria-label="Lessons">
				{
					previous && (
						<a class="button" rel="prev" href={`${path}/${previous.slug}`}>
							Previous: {previous.title}
						</a>
					)
				}
				{
					next && (
						<a class="button" rel="next" href={`${path}/${next.slug}`}>
							Next: {next.title}
						</a>
					)
				}
			</nav>
		</Block>
	</main>
</Layout>

<style>
	.workshop-lesson {
		background: var(--black);
	}

	h1 {
		font-size: clamp(2rem, 6cqi, 3.5rem);
		line-height: 1.05;
		margin-block-start: 0;
	}

	.workshop-lesson :global([data-name='lesson-hero']) {
		padding-block-end: 1.5rem;
	}

	.workshop-lesson :global([data-name='lesson-content']) {
		padding-block-start: 1.5rem;
	}

	.breadcrumb {
		justify-self: start;
		min-inline-size: 0;
	}

	.breadcrumb a {
		color: var(--text-link);
		display: inline-block;
		line-height: 1.5;
		overflow-wrap: anywhere;
		padding-block: 0.5rem;
		text-underline-offset: 0.2em;
	}

	.breadcrumb a::before {
		content: '← ';
	}

	.lesson-video {
		aspect-ratio: 16 / 9;
		container-type: size;
		grid-column: 1 / -1;
		inline-size: 100%;
		min-inline-size: 0;
	}

	.lesson-body,
	.lesson-notice,
	.lesson-navigation {
		min-inline-size: 0;
	}

	.lesson-body > section + section {
		margin-block-start: 2.5rem;
	}

	.lesson-navigation {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.lesson-navigation .button {
		line-height: 1.35;
		margin-block-start: 0;
		min-block-size: 44px;
		max-inline-size: 100%;
		overflow-wrap: anywhere;
		padding: 0.75rem 1rem;
	}

	.breadcrumb a:focus-visible,
	.lesson-navigation .button:focus-visible {
		outline: 3px solid var(--orange);
		outline-offset: 4px;
	}

	@media (min-width: 800px) {
		.lesson-body,
		.lesson-notice,
		.lesson-navigation {
			grid-column: 2;
		}
	}

	@media (min-width: 1180px) {
		.workshop-lesson :global([data-name='lesson-hero']) {
			/* Match the landing hero below the fixed desktop header. */
			padding-block-start: 5rem;
		}
	}
</style>
